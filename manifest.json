{
  "manifest_version": 3,
  "name": "frame-mesh",
  "version": "0.1.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "side_panel": {
    "default_path": "extension/panel.html"
  },
  "permissions": [
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/core/*.js",
        "src/panel/*.js",
        "src/panel/*.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
